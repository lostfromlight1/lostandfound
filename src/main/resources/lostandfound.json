{
  "info": {
    "name": "LostAndFound API - Full Suite",
    "description": "Complete API testing suite including Auth, Users, Posts, Comments, Images, and Categories.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "api_key", "value": "your-default-dev-key" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "1" },
    { "key": "post_id", "value": "1" },
    { "key": "comment_id", "value": "1" },
    { "key": "category_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Test User\",\n  \"contactInfo\": \"123-456-7890\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.accessToken) { pm.collectionVariables.set('access_token', jsonData.payload.accessToken); }",
                  "if(jsonData.payload && jsonData.payload.refreshToken) { pm.collectionVariables.set('refresh_token', jsonData.payload.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/google" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"google-oauth-token-here\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "description": "Note: Controller uses CookieValue 'app_refresh_token'",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Cookie", "value": "app_refresh_token={{refresh_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Cookie", "value": "app_refresh_token={{refresh_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout" }
          }
        }
      ]
    },
    {
      "name": "2. User Management",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me" }
          }
        },
        {
          "name": "ADMIN: Unban User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/unban" }
          }
        }
      ]
    },
    {
      "name": "3. Post Management",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.id) { pm.collectionVariables.set('post_id', jsonData.payload.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/posts/create" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lost Wallet\",\n  \"description\": \"Brown leather wallet lost near downtown.\",\n  \"type\": \"LOST\",\n  \"categoryId\": 1,\n  \"location\": \"YANGON\",\n  \"imageUrls\": []\n}"
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts?page=0&size=5&type=LOST",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" },
                { "key": "type", "value": "LOST" }
              ]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"Updated Description\"\n}"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/posts/{{post_id}}" }
          }
        }
      ]
    },
    {
      "name": "4. Comment Management",
      "item": [
        {
          "name": "Create Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.id) { pm.collectionVariables.set('comment_id', jsonData.payload.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/comments" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": {{post_id}},\n  \"content\": \"I might have seen this!\"\n}"
            }
          }
        },
        {
          "name": "Get Comments by Post",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/comments/post/{{post_id}}" }
          }
        }
      ]
    },
    {
      "name": "5. Image Management",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/images/upload" },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Category Management",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/categories" }
          }
        },
        {
          "name": "ADMIN: Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.id) { pm.collectionVariables.set('category_id', jsonData.payload.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/categories" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\"\n}"
            }
          }
        }
      ]
    }
  ]
}