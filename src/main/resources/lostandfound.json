{
  "info": {
    "name": "LostAndFound API",
    "description": "Complete API testing suite for the Lost & Found application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "api_key", "value": "your-default-dev-key" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Test User\",\n  \"contactInfo\": \"123-456-7890\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.accessToken) { pm.collectionVariables.set('access_token', jsonData.payload.accessToken); }",
                  "if(jsonData.payload && jsonData.payload.refreshToken) { pm.collectionVariables.set('refresh_token', jsonData.payload.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email?token=paste-verification-token-here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-email"],
              "query": [ { "key": "token", "value": "paste-verification-token-here" } ]
            }
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-verification?email=test@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-verification"],
              "query": [ { "key": "email", "value": "test@example.com" } ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.accessToken) { pm.collectionVariables.set('access_token', jsonData.payload.accessToken); }",
                  "if(jsonData.payload && jsonData.payload.refreshToken) { pm.collectionVariables.set('refresh_token', jsonData.payload.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Reset Password Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password?email=test@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"],
              "query": [ { "key": "email", "value": "test@example.com" } ]
            }
          }
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password/confirm", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset-password", "confirm"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-uuid-from-email-here\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. User Management",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.payload && jsonData.payload.id) { pm.collectionVariables.set('user_id', jsonData.payload.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "me"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/update", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "update"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated Tester Name\",\n  \"contactInfo\": \"updated@example.com\"\n}"
            }
          }
        },
        {
          "name": "Get Public Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/profile", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{user_id}}", "profile"] }
          }
        },
        {
          "name": "ADMIN: Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [ { "key": "page", "value": "0" }, { "key": "size", "value": "20" } ]
            }
          }
        },
        {
          "name": "ADMIN: Search Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/search?query=test&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [ { "key": "query", "value": "test" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" } ]
            }
          }
        },
        {
          "name": "ADMIN: Ban User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-KEY", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/ban", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "{{user_id}}", "ban"] }
          }
        }
      ]
    }
  ]
}